{
  "env": {
    "ANTHROPIC_BASE_URL": "https://ai.drwcloud.com",
    "ANTHROPIC_AUTH_TOKEN": "<REDACTED>",
    "ANTHROPIC_CUSTOM_HEADERS": "x-portkey-api-key: <REDACTED>\nx-portkey-config: pc-bedroc-55aa53\nx-portkey-metadata: {\"service\": \"claude-code\", \"os\": \"linux\"}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8"
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/worktree-create.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tail:*)",
      "Read(~/.claude/**)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(rg *)"
    ],
    "ask": [
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)"
    ]
  },
  "model": "claude-opus-4-8[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "fullstack-dev-skills@fullstack-dev-skills": true,
    "skill-creator@chippy": true,
    "git-ops@chippy": true,
    "kpop@chippy": true,
    "python-env@chippy": true,
    "crispy@chippy": true,
    "code-review@claude-plugins-official": false,
    "cp-review@chippy": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "fullstack-dev-skills": {
      "source": {
        "source": "github",
        "repo": "jeffallan/claude-skills"
      }
    },
    "chippy": {
      "source": {
        "source": "git",
        "url": "git@git.drwholdings.com:Chippy/core-python-claude-skills.git"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim"
}
